# 复制为 .env 后按需修改（.env 不要提交到代码仓库）

# 监听地址与端口：容器/云平台需要 0.0.0.0
HOST=0.0.0.0
PORT=8787

# 数据库文件所在目录（本地/VPS/Docker 部署用；务必放在持久化磁盘/卷上）
DATA_DIR=./data

# ---- 外部存储（可选，二选一）----
# 免费容器平台（Render/Railway 免费实例）的文件系统是临时的，重启会清空 SQLite，
# 因此这类环境请填下面两项，用外部 Redis 持久化（Upstash 免费版即可，无需信用卡）。
# 只要这两项存在，服务端会自动改用外部存储，DATA_DIR 不再使用。
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# 走 HTTPS 对外时打开：Cookie 加 Secure 标记
SECURE_COOKIES=0
# 前面有 Nginx/Caddy/云负载均衡时打开：信任 X-Forwarded-For / X-Forwarded-Proto
TRUST_PROXY=0

# 可选：大模型模式（OpenAI 兼容接口）。不填则始终使用本地规则引擎。
LLM_ENDPOINT=
LLM_MODEL=
LLM_API_KEY=
